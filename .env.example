# Porta onde o site vai rodar
PORT=3000

# Numero(s) autorizado(s) a registrar gastos, separados por virgula.
# Formato: DDI + DDD + numero, sem espacos/simbolos. Ex: 5585999999999
NUMEROS_AUTORIZADOS=5585999999999

# Groq (gratis) - crie sua chave em https://console.groq.com/keys
GROQ_API_KEY=sua_chave_groq_aqui
GROQ_MODEL=llama-3.1-8b-instant

# Firebase - baixe o JSON da conta de servico em:
# Firebase Console > Configuracoes do projeto > Contas de servico > Gerar nova chave privada
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
FIREBASE_PROJECT_ID=financeiro-livia

# Nome da colecao no Firestore onde os gastos serao salvos
FIRESTORE_COLLECTION=gastos
